+// --- Import ---------------------------------------------------------------
+
+fn draft_response(feature_id: &str, contract_body: &str, notes: Option<&str>) -> String {
+    let mut s = String::new();
+    s.push_str(BEGIN);
+    s.push('\n');
+    s.push_str(NOTES);
+    s.push('\n');
+    if let Some(n) = notes {
+        s.push_str(n);
+        s.push('\n');
+    }
+    s.push_str(&format!(
+        "--- SPECDRIVE:FILE docs/features/{}/contract.yaml ---\n",
+        feature_id
+    ));
+    s.push_str(contract_body);
+    if !contract_body.ends_with('\n') {
+        s.push('\n');
+    }
+    s.push_str(END);
+    s.push('\n');
+    s
+}
